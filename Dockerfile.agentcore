# AgentCore Runtime image: MUST be linux/arm64, serves /invocations + /ping
# on 8080 via BedrockAgentCoreApp. Build with:
#   docker buildx build --platform linux/arm64 -f Dockerfile.agentcore \
#     -t <acct>.dkr.ecr.us-east-1.amazonaws.com/wpilot-agent:agentcore .
FROM --platform=linux/arm64 python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/wpilot-agent/src \
    AWS_REGION=us-east-1

WORKDIR /app
COPY wpilot-agent/src ./wpilot-agent/src
COPY wpilot-agent/seeds ./wpilot-agent/seeds

RUN pip install --no-cache-dir \
      strands-agents==1.54.0 \
      bedrock-agentcore==1.22.0 \
      boto3

EXPOSE 8080
CMD ["python", "-m", "wpilot.agentcore_app"]
